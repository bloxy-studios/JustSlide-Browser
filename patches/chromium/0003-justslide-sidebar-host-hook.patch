 #include "chrome/browser/ui/views/frame/web_contents_close_handler.h"
 #include "chrome/browser/ui/views/fullscreen_control/fullscreen_control_host.h"
 #include "chrome/browser/ui/views/glic/glic_button_interface.h"
@@ -996,6 +997,9 @@ BrowserView::BrowserView(BrowserWindowInterface* browser)
     }
     vertical_tab_strip_region_view_ =
         AddChildView(std::move(vertical_tab_strip_container));
+    // JustSlide: host the trusted sidebar WebUI in the leading-edge region.
+    justslide::JustSlideSidebarHost::MaybeAttach(
+        vertical_tab_strip_region_view_.get(), browser_.get());
 
     vertical_tab_strip_top_corner_ =
         AddChildView(std::make_unique<CustomFloatingCorner>(
