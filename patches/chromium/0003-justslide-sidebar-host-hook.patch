Subject: [PATCH] 0003-justslide-sidebar-host-hook

Purpose: Attach JustSlideSidebarHost in BrowserView leading-edge region (feature-gated)
Subsystem: chrome/browser/ui/views/frame
Upstream: chromium/src 157.0.8103.51 (653674df293788cf4932c40d914e9e15b41a2d31)
Tests: tests: JustSlideBrowserTest.*, interactive_ui_tests (planned)
---
 chrome/browser/ui/views/frame/BUILD.gn        | 1 +
 chrome/browser/ui/views/frame/browser_view.cc | 4 ++++
 2 files changed, 5 insertions(+)

diff --git a/chrome/browser/ui/views/frame/BUILD.gn b/chrome/browser/ui/views/frame/BUILD.gn
index 07ff356..578ea96 100644
--- a/chrome/browser/ui/views/frame/BUILD.gn
+++ b/chrome/browser/ui/views/frame/BUILD.gn
@@ -767,6 +767,7 @@ source_set("browser_view") {
     "//chrome/browser:browser_public_dependencies",
   ]
   deps = [
+    "//justslide/ui",
     ":app_menu_button",
     ":browser_frame_view",
     ":browser_native_widget",
diff --git a/chrome/browser/ui/views/frame/browser_view.cc b/chrome/browser/ui/views/frame/browser_view.cc
index d441b8a..84419bb 100644
--- a/chrome/browser/ui/views/frame/browser_view.cc
+++ b/chrome/browser/ui/views/frame/browser_view.cc
@@ -184,6 +184,7 @@
 #include "chrome/browser/ui/views/frame/top_controls_slide_controller.h"
