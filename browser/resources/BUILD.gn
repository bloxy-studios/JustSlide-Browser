# Copyright 2026 Bloxy Studios.
# Maps to //justslide/resources. Packages the *prebuilt* Parcel output
# (ui/browser-chrome/dist/webui, staged by scripts/engine/stage-ui.sh into
# $root_gen_dir-independent `webui_dist/`) with GRIT. No dev server, no remote
# scripts or fonts. The Mojo module is generated by //justslide/webui:mojo_bindings.
import("//tools/grit/grit_rule.gni")
import("//ui/webui/resources/tools/generate_grd.gni")

_dist = "webui_dist"
_files = read_file("$_dist/files.json", "json")

generate_grd("build_grd") {
  grd_prefix = "justslide_sidebar"
  out_grd = "$target_gen_dir/resources.grd"
  input_files_base_dir = rebase_path(_dist, "//")
  input_files = _files
  # Mojo WebUI bindings for justslide_shell.mojom (served at the WebUI root).
  grdp_files = [ "$target_gen_dir/mojo.grdp" ]
  deps = [ ":mojo_grdp" ]
}

generate_grd("mojo_grdp") {
  grd_prefix = "justslide_sidebar"
  out_grd = "$target_gen_dir/mojo.grdp"
  input_files_base_dir = rebase_path("$root_gen_dir/justslide/webui", root_build_dir)
  input_files = [ "justslide_shell.mojom-webui.js" ]
  deps = [ "//justslide/webui:mojo_bindings_ts__generator" ]
}

grit("resources") {
  enable_input_discovery_for_gn_analyze = false
  source = "$target_gen_dir/resources.grd"
  deps = [ ":build_grd" ]
  outputs = [
    "grit/justslide_sidebar_resources.h",
    "grit/justslide_sidebar_resources_map.cc",
    "grit/justslide_sidebar_resources_map.h",
    "justslide_sidebar_resources.pak",
  ]
  output_dir = "$root_gen_dir/justslide"
}
