import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojo_bindings") {
  sources = [ "justslide_shell.mojom" ]
  public_deps = [ "//url/mojom:url_mojom_gurl" ]
  # Generates justslide_shell.mojom-webui.js, served at the WebUI root and
  # imported at runtime by ui/browser-chrome/src/bridge/mojo.ts.
  webui_module_path = "/"
}

source_set("webui") {
  sources = [
    "justslide_page_handler.cc",
    "justslide_page_handler.h",
    "justslide_sidebar_ui.cc",
    "justslide_sidebar_ui.h",
  ]
  deps = [
    ":mojo_bindings",
    "//base",
    "//chrome/browser/autocomplete",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui:browser_window_header",
    "//chrome/browser/ui/navigator",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/webui:favicon_source",
    "//chrome/browser/ui/webui:webui_util",
    "//chrome/browser/ui/webui/top_chrome",
    "//components/omnibox/browser",
    "//content/public/browser",
    "//justslide/browser",
    "//justslide/common",
    "//justslide/resources",
    "//ui/webui",
  ]
}
