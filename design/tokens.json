    },
    "text-tertiary": {
      "derived": {
        "mint": "rgba(14, 27, 27, 0.42)"
      },
      "usage": "decorative glyph-adjacent text only, never body copy"
    },
    "pressed": {
      "derived": {
        "mint": "rgba(14, 27, 27, 0.11)"
