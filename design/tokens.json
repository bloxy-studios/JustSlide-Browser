{
  "$comment": "Semantic JustSlide tokens. Colour values are NOT typed here: `figmaVar` entries are resolved per theme from design/figma/snapshot.json (Figma variable collection 50:24, modes mint=50:0, light=50:1, dark=55:1). `literal` entries are unbound values copied from the named Figma node. `derived` entries are not in Figma and are documented in docs/design-system.md. Generate CSS with `bun run design:tokens`.",
  "themes": ["mint", "light", "dark"],
  "colors": {
    "frame":              { "figmaVar": "VariableID:55:67", "usage": "window backdrop behind sidebar and page" },
    "sidebar":            { "figmaVar": "VariableID:55:68", "usage": "sidebar column fill" },
    "page":               { "figmaVar": "VariableID:55:69", "usage": "web page window fill (native)" },
    "page-border":        { "figmaVar": "VariableID:55:70", "usage": "web page window 1px stroke (native)" },
    "separator":          { "figmaVar": "VariableID:55:71", "usage": "pinned/tabs section separator" },
    "address":            { "figmaVar": "VariableID:55:77", "usage": "address bar fill" },
    "favorite":           { "figmaVar": "VariableID:55:79", "usage": "favorite website tile fill" },
    "favorite-add":       { "figmaVar": "VariableID:55:80", "usage": "add-favorite tile fill" },
    "border-dashed":      { "figmaVar": "VariableID:55:106", "usage": "add-favorite dashed stroke" },
    "tab-selected":       { "figmaVar": "VariableID:55:85", "usage": "selected tab fill" },
    "border-strong":      { "figmaVar": "VariableID:55:105", "usage": "selected tab / workspace / agent card stroke" },
    "workspace-selected": { "figmaVar": "VariableID:55:89", "usage": "selected workspace button fill" },
    "workspace-idle":     { "figmaVar": "VariableID:56:43", "usage": "unselected workspace button fill" },
    "agent-card":         { "figmaVar": "VariableID:55:91", "usage": "background agent activity card fill" },
    "agent-control":      { "figmaVar": "VariableID:55:74", "usage": "pause/resume control fill" },
    "activity":           { "figmaVar": "VariableID:55:93", "usage": "background activity dot" },
    "text":               { "figmaVar": "VariableID:55:96", "usage": "primary text (address, titles, agent state)" },
    "text-muted":         { "figmaVar": "VariableID:55:97", "usage": "pinned count, agent scope (with opacity)" },
    "text-label":         { "figmaVar": "VariableID:55:98", "usage": "WORKSPACES overline (with opacity)" },
    "text-workspace":     { "figmaVar": "VariableID:55:90", "usage": "current workspace name" },
    "icon":               { "figmaVar": "VariableID:55:102", "usage": "glyph colour (Nucleo outline/fill icons)" },
    "tooltip":            { "figmaVar": "VariableID:55:109", "fallbackTheme": "mint", "usage": "hover label fill (bound only in mint frames)" },
    "tooltip-text":       { "figmaVar": "VariableID:55:110", "fallbackTheme": "mint", "usage": "hover label text" },
    "tab-hover":          { "literal": { "mint": "#f2fffd", "light": "#f2fffd" }, "node": "30:67 Slide / Tab State=Hover", "derived": { "dark": "#3c525e" }, "usage": "hovered tab fill" },
    "focus-ring":         { "literal": { "mint": "#10574f", "light": "#10574f" }, "node": "30:89 Slide / Tab State=Keyboard focus", "derived": { "dark": "#71d8bd" }, "usage": "keyboard focus dashed outline" },
    "close-glyph":        { "literal": { "mint": "#304b48", "light": "#304b48" }, "node": "Close icon (I30:103;30:87)", "derived": { "dark": "#c5d4db" }, "usage": "tab close glyph" },
    "danger":             { "derived": { "mint": "#b3261e", "light": "#b3261e", "dark": "#ffb4ab" }, "usage": "crashed/failed tab marker, insecure origin (not in Figma)" }
  },
  "opacity": {
    "count": 0.6,
    "scope": 0.72,
    "label": 0.68
  },
  "type": {
    "$fontFamily": "Figma uses 'SF Pro' (macOS system font). Chromium WebUI on macOS resolves system-ui/-apple-system to SF Pro.",
    "tab":          { "size": 13, "weight": 510, "lineHeight": 18, "node": "Slide / Tab Title" },
    "tab-selected": { "size": 13, "weight": 590, "lineHeight": 18, "node": "State=Selected Title" },
    "address":      { "size": 12, "weight": 510, "lineHeight": 18, "node": "Address" },
    "section":      { "size": 12, "weight": 590, "lineHeight": 18, "node": "Section Title (Pinned)" },
    "count":        { "size": 11, "weight": 510, "lineHeight": 18, "node": "Pinned count" },
    "overline":     { "size": 10, "weight": 590, "lineHeight": 16, "letterSpacing": 0.6, "case": "upper", "node": "Workspace heading Label" },
    "caption":      { "size": 11, "weight": 510, "lineHeight": 16, "node": "Current workspace / Agent scope" },
    "agent-title":  { "size": 12, "weight": 590, "lineHeight": 18, "node": "Agent state" },
    "tooltip":      { "size": 12, "weight": 510, "lineHeight": 18, "node": "Slide / Tooltip Label" }
  },
  "size": {
    "frame-padding": 12, "frame-gap": 12, "sidebar-width": 240, "sidebar-gap": 8,
    "nav-height": 40, "target": 32, "target-small": 24, "icon": 16, "icon-small": 12, "icon-indicator": 14,
    "address-height": 32, "favorite-width": 43, "favorite-height": 34, "favorite-icon": 18, "favorites-gap": 4,
    "row-height": 32, "trigger-height": 28, "favicon": 16, "list-gap": 4,
    "agent-card-height": 56, "footer-height": 64, "workspace-switcher-gap": 4, "activity-dot": 7,
    "tooltip-height": 32, "tooltip-width": 224, "collapsed-rail": 48
  },
  "radius": { "control": 8, "small": 6, "card": 10, "page": 16, "favicon": 3 }
}
