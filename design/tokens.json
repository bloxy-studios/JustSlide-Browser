{
  "$comment": "Semantic JustSlide tokens. Colour values are NOT typed here: `figmaVar` entries are resolved from design/figma/snapshot.json (Figma variable collection 50:24, mode mint=50:0). Owner decision 2026-11-13: mint is the only colour theme; the backdrop is user-customisable (solid colour or frosted glass); strokes are replaced by shadows. `literal` entries are unbound values copied from the named Figma node. `derived` entries are not in Figma and are documented in docs/design-system.md. Generate CSS with `bun run design:tokens`.. Owner decision 2026-11-13 (later): sidebar and window background are ONE colour layer, frame padding and sidebar-page gap 6 px (as in Figma 1:6).",
  "themes": [
    "mint"
  ],
  "colors": {
    "frame": {
      "figmaVar": "VariableID:55:67",
      "usage": "window backdrop behind sidebar and page"
    },
    "sidebar": {
      "figmaVar": "VariableID:55:68",
      "usage": "sidebar column fill"
    },
    "page": {
      "figmaVar": "VariableID:55:69",
      "usage": "web page window fill (native)"
    },
    "page-border": {
      "figmaVar": "VariableID:55:70",
      "usage": "web page window 1px stroke (native)"
    },
    "separator": {
      "derived": {
        "mint": "rgba(14, 27, 27, 0.12)"
      },
      "usage": "hairline separator (macOS separatorColor-like); replaces Figma #627f87 line"
    },
    "address": {
      "figmaVar": "VariableID:55:77",
      "usage": "address bar fill"
    },
    "favorite": {
      "figmaVar": "VariableID:55:79",
      "usage": "favorite website tile fill"
    },
    "favorite-add": {
      "figmaVar": "VariableID:55:80",
      "usage": "add-favorite tile fill"
    },
    "border-dashed": {
      "figmaVar": "VariableID:55:106",
      "usage": "add-favorite dashed stroke"
    },
    "tab-selected": {
      "figmaVar": "VariableID:55:85",
      "usage": "selected tab fill"
    },
    "border-strong": {
      "figmaVar": "VariableID:55:105",
      "usage": "selected tab / workspace / agent card stroke"
    },
    "workspace-selected": {
      "figmaVar": "VariableID:55:89",
      "usage": "selected workspace button fill"
    },
    "workspace-idle": {
      "figmaVar": "VariableID:56:43",
      "usage": "unselected workspace button fill"
    },
    "agent-card": {
      "figmaVar": "VariableID:55:91",
      "usage": "background agent activity card fill"
    },
    "agent-control": {
      "figmaVar": "VariableID:55:74",
      "usage": "pause/resume control fill"
    },
    "activity": {
      "figmaVar": "VariableID:55:93",
      "usage": "background activity dot"
    },
    "text": {
      "figmaVar": "VariableID:55:96",
      "usage": "primary text (address, titles, agent state)"
    },
    "text-muted": {
      "derived": {
        "mint": "rgba(14, 27, 27, 0.66)"
      },
      "usage": "secondary label (counts, captions, agent scope, placeholders); \u22654.5:1 on mint and on white"
    },
    "text-label": {
      "derived": {
        "mint": "rgba(14, 27, 27, 0.66)"
      },
      "usage": "sidebar section headers (Pinned, Workspaces), macOS style: title case, semibold, secondary"
    },
    "text-workspace": {
      "derived": {
        "mint": "rgba(14, 27, 27, 0.66)"
      },
      "usage": "current workspace name (secondary label)"
    },
    "icon": {
      "figmaVar": "VariableID:55:102",
      "usage": "glyph colour (Nucleo outline/fill icons)"
    },
    "tooltip": {
      "figmaVar": "VariableID:55:109",
      "fallbackTheme": "mint",
      "usage": "hover label fill (bound only in mint frames)"
    },
    "tooltip-text": {
      "figmaVar": "VariableID:55:110",
      "fallbackTheme": "mint",
      "usage": "hover label text"
    },
    "tab-hover": {
      "derived": {
        "mint": "rgba(14, 27, 27, 0.06)"
      },
      "usage": "toolbar/icon-button hover bezel (macOS 26 toolbar item hover); list rows do not hover-highlight"
    },
    "focus-ring": {
      "derived": {
        "mint": "color-mix(in srgb, AccentColor 60%, transparent)"
      },
      "usage": "keyboard focus ring: system accent colour (macOS Keyboard focus ring), 3px"
    },
