  "shadow": {
    "$comment": "Derived (owner decision 2026-11-13: \"use shadows instead of borders\"). Figma draws these as 1px strokes (variable 55:105 / 55:70). Page window: no shadow (owner 2026-11-13: the web area sits inside the background, not floating). Keyboard focus uses the native accent focus ring (outline), not a shadow.",
    "control": "0 1px 2px rgba(14, 27, 27, 0.10), 0 0 0 0.5px rgba(14, 27, 27, 0.04)",
    "selected": "0 1px 3px rgba(14, 27, 27, 0.14), 0 1px 1px rgba(14, 27, 27, 0.06)",
    "card": "0 2px 8px rgba(14, 27, 27, 0.12), 0 1px 2px rgba(14, 27, 27, 0.06)",
