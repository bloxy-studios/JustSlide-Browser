        "mint": "rgba(14, 27, 27, 0.66)"
      },
      "usage": "secondary glyphs (pin, chevrons, new-tab plus)"
    },
    "accent": {
      "derived": {
        "mint": "AccentColor"
      },
      "usage": "default (primary) button, menu highlight: follows System Settings \u25b8 Appearance \u25b8 Accent colour"
    },
    "accent-text": {
      "derived": {
        "mint": "AccentColorText"
      },
      "usage": "text on accent"
    }
  },
  "opacity": {
    "count": 1,
    "scope": 1,
    "label": 1
