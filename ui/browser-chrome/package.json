{
  "name": "@justslide/browser-chrome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "parcel serve src/preview.html src/gallery.html --port 41730 --dist-dir .parcel-dev --no-cache",
    "build": "bun ../../scripts/ui/gen-icon-glyphs.ts && parcel build --target webui --no-cache && bun ../../scripts/ui/finalize-webui.ts",
    "build:preview": "parcel build --target preview --no-cache",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "check:glyphs": "bun ../../scripts/ui/gen-icon-glyphs.ts --check"
  },
  "dependencies": {
    "@atlaskit/badge": "22.0.0",
    "@atlaskit/button": "25.8.1",
    "@atlaskit/css": "1.1.8",
    "@atlaskit/css-reset": "8.4.10",
    "@atlaskit/dropdown-menu": "21.3.1",
    "@atlaskit/heading": "8.0.0",
    "@atlaskit/icon": "38.0.2",
    "@atlaskit/lozenge": "17.0.8",
    "@atlaskit/modal-dialog": "17.2.4",
    "@atlaskit/primitives": "22.7.1",
    "@atlaskit/section-message": "10.2.6",
    "@atlaskit/spinner": "20.4.4",
    "@atlaskit/textfield": "10.3.1",
    "@atlaskit/tokens": "20.11.0",
    "@atlaskit/tooltip": "24.4.5",
    "@compiled/react": "1.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@compiled/parcel-config": "0.5.7",
    "@compiled/vite-plugin": "2.1.0",
    "@parcel/config-default": "2.16.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "parcel": "2.16.4",
    "playwright-core": "1.65.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "targets": {
    "webui": {
      "source": "src/sidebar.html",
      "distDir": "dist/webui",
      "context": "browser",
      "outputFormat": "esmodule",
      "isLibrary": false,
      "sourceMap": false,
      "engines": {
        "browsers": "Chrome 104"
      },
      "publicUrl": "./"
    },
    "preview": {
      "source": [
        "src/preview.html",
        "src/gallery.html"
      ],
      "distDir": "dist/preview",
      "context": "browser",
      "outputFormat": "esmodule",
      "sourceMap": false,
      "engines": {
        "browsers": "Chrome 104"
      },
      "publicUrl": "./"
    }
  }
}
