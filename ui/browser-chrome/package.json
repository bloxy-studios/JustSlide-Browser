{
  "name": "@justslide/browser-chrome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "parcel serve src/preview.html --port 41730 --dist-dir .parcel-dev --no-cache",
    "build": "rm -rf dist/webui && bun ../../scripts/design/gen-tokens.ts --check && bun ../../scripts/ui/gen-icons.ts --check && parcel build --target webui --no-cache && bun ../../scripts/ui/finalize-webui.ts",
    "build:preview": "rm -rf dist/preview && parcel build --target preview --no-cache",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "build:icons": "bun ../../scripts/ui/gen-icons.ts",
    "check:icons": "bun ../../scripts/ui/gen-icons.ts --check"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@parcel/config-default": "2.16.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "parcel": "2.16.4",
    "playwright-core": "1.65.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "targets": {
    "webui": {
      "source": "src/sidebar.html",
      "distDir": "dist/webui",
      "context": "browser",
      "outputFormat": "esmodule",
      "isLibrary": false,
      "sourceMap": false,
      "engines": {
        "browsers": "Chrome 104"
      },
      "publicUrl": "./"
    },
    "preview": {
      "source": [
        "src/preview.html"
      ],
      "distDir": "dist/preview",
      "context": "browser",
      "outputFormat": "esmodule",
      "sourceMap": false,
      "engines": {
        "browsers": "Chrome 104"
      },
      "publicUrl": "./"
    }
  }
}
